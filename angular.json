{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": "62facf0c-7acf-4736-abc4-444ed2644f51"
  },
  "newProjectRoot": "projects",
  "projects": {
    "ServiciosWebnegocio": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": { "base": "dist/ServiciosWebnegocio", "browser": "browser" },
            "index": "src/index.html",
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "src/styles.css"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1.35MB",
                  "maximumError": "1.75MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "48kB",
                  "maximumError": "60kB"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.development.ts",
                  "with": "src/environments/environment.ts"
                }
              ],
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": true
                },
                "fonts": false
              },
              "outputHashing": "all"
            },
            "development": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.development.ts"
                }
              ],
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "marketing": {
              "browser": "src/main.marketing.ts",
              "styles": [
                "src/styles.marketing.css",
                {
                  "input": "src/styles.tenant-public.css",
                  "bundleName": "tenant-public",
                  "inject": false
                }
              ],
              "index": "src/index.html",
              "tsConfig": "tsconfig.marketing.json",
              "outputPath": { "base": "dist/marketing", "browser": "browser" }
            },
            "application": {
              "browser": "src/main.application.ts",
              "index": {
                "input": "src/index.app.html",
                "output": "index.html"
              },
              "tsConfig": "tsconfig.application.json",
              "outputPath": { "base": "dist/application", "browser": "browser" }
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "proxyConfig": "proxy.conf.json"
          },
          "configurations": {
            "production": {
              "buildTarget": "ServiciosWebnegocio:build:production"
            },
            "development": {
              "buildTarget": "ServiciosWebnegocio:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test-build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/ServiciosWebnegocio/test",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [],
            "styles": [
              "src/styles.css"
            ]
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "ServiciosWebnegocio:test-build",
            "runnerConfig": "vitest.config.mjs"
          }
        }
      }
    }
  }
}
