{
  "functions": {
    "source": "functions",
    "runtime": "nodejs22",
    "predeploy": [
      "npm --prefix functions run prepare-template"
    ]
  },
  "hosting": [
    {
      "target": "marketing",
      "public": "dist/ServiciosWebnegocio/browser",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "/",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-store, no-cache, must-revalidate, max-age=0"
            }
          ]
        },
        {
          "source": "**/*.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-store, no-cache, must-revalidate, max-age=0"
            }
          ]
        },
        {
          "source": "/runtime-config.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-store, no-cache, must-revalidate, max-age=0"
            }
          ]
        },
        {
          "source": "/index.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-store, no-cache, must-revalidate, max-age=0"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "/api/**",
          "function": {
            "functionId": "apiProxy",
            "region": "us-central1"
          }
        },
        {
          "source": "/sitemap.xml",
          "function": {
            "functionId": "sitemap",
            "region": "us-central1"
          }
        },
        {
          "source": "/e/**",
          "function": {
            "functionId": "tenantPage",
            "region": "us-central1"
          }
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "target": "app",
      "public": "dist/ServiciosWebnegocio/browser",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "/",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-store, no-cache, must-revalidate, max-age=0"
            }
          ]
        },
        {
          "source": "**/*.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-store, no-cache, must-revalidate, max-age=0"
            }
          ]
        },
        {
          "source": "/runtime-config.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-store, no-cache, must-revalidate, max-age=0"
            }
          ]
        },
        {
          "source": "/index.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-store, no-cache, must-revalidate, max-age=0"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "/api/**",
          "function": {
            "functionId": "apiProxy",
            "region": "us-central1"
          }
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
  ]
}
