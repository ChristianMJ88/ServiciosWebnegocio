SPRING_PROFILES_ACTIVE=dev
DB_HOST=localhost
DB_PORT=3302
DB_NAME=agenda_db
DB_USER=agenda_user
DB_PASSWORD=agenda_pass
JWT_SECRETO=agenda-dev-jwt-secreto-seguro-2026-32chars
INVITACIONES_URL_ACEPTACION=http://localhost:4200/invitacion/aceptar
RECUPERACION_CONTRASENA_URL=http://localhost:4200/recuperar-contrasena/confirmar

# Cloudinary. Mantén los valores reales en backend/.env o en el gestor de
# secretos del entorno de producción.
CLOUDINARY_HABILITADO=true
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_CARPETA_RAIZ=Fluora
CLOUDINARY_MAX_TAMANO_IMAGEN=10MB

# Mercado Pago Marketplace. Las credenciales reales pertenecen a Fluora y se
# guardan únicamente en este archivo local o en el gestor de secretos.
MERCADO_PAGO_HABILITADO=false
MERCADO_PAGO_AMBIENTE=PRUEBA
MERCADO_PAGO_CLIENT_ID=
MERCADO_PAGO_CLIENT_SECRET=
# Mercado Pago exige HTTPS y la URI debe coincidir exactamente con la registrada.
# Para desarrollo usa un túnel HTTPS registrado en la aplicación de pruebas.
MERCADO_PAGO_REDIRECT_URI=https://api.refluora.com/api/v1/admin/pagos/mercado-pago/oauth/callback
MERCADO_PAGO_FRONTEND_RESULTADO_URL=https://app.refluora.com/admin/sitio
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_PRUEBA_PUBLIC_KEY=
MERCADO_PAGO_PRUEBA_ACCESS_TOKEN=
PAGOS_LLAVE_CIFRADO_SECRETOS=

# Google Maps Platform. Usa dos claves distintas: una restringida por dominio
# para Places y otra restringida por IP/API para Address Validation.
GOOGLE_MAPS_HABILITADO=false
GOOGLE_MAPS_VALIDACION_REQUERIDA=true
GOOGLE_MAPS_BROWSER_API_KEY=
GOOGLE_MAPS_SERVER_API_KEY=
GOOGLE_MAPS_REGION_PREDETERMINADA=MX
GOOGLE_MAPS_REGIONES_PERMITIDAS=MX

WHATSAPP_HABILITADO=true
WHATSAPP_EMPRESA_ID=1
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=tu_auth_token

# Si tu remitente esta habilitado para WhatsApp, usa tu sender:
# TWILIO_WHATSAPP_FROM=whatsapp:+12605477714
#
# Si aun no tienes sender de WhatsApp habilitado, usa sandbox:
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_STATUS_CALLBACK_URL=

TWILIO_WHATSAPP_TEMPLATE_SOLICITUD_CONFIRMACION_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_TEMPLATE_REPROGRAMADA_PENDIENTE_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_TEMPLATE_RECORDATORIO_CONFIRMACION_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_TEMPLATE_CITA_CONFIRMADA_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_TEMPLATE_RECORDATORIO_SID=
TWILIO_WHATSAPP_TEMPLATE_CANCELACION_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_TEMPLATE_LIBERADA_SIN_CONFIRMACION_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_TEMPLATE_GRACIAS_VISITA_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_TEMPLATE_RECORDATORIO_REGRESO_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_LOTE_MAXIMO_OUTBOX=20
WHATSAPP_REINTENTO_SEGUNDOS=60
WHATSAPP_RECORDATORIO_HORAS_ANTES=24
WHATSAPP_RECORDATORIO_VENTANA_MINUTOS=60
WHATSAPP_LIBERACION_SIN_CONFIRMACION_HORAS_ANTES=2
